# bballin.me – Apache configuration (Strato shared hosting)
# Every block is wrapped in <IfModule> so a missing module never breaks the site.

DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Old language parameter -> real pages
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
  RewriteRule ^(index\.html)?$ /en/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
  RewriteRule ^impressum\.html$ /en/legal.html? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)lang=de(&|$)
  RewriteRule ^(index\.html)?$ /? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)lang=de(&|$)
  RewriteRule ^impressum\.html$ /impressum.html? [R=301,L]

  # /en/index.html -> /en/
  RewriteRule ^en/index\.html$ /en/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Everything is self-hosted. The form posts to /contact.php on this host.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>

# Never serve repo housekeeping or source files
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.gitignore|\.git.*|.*\.(tex|md|yml|yaml|json|log|bak|py))$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.gitignore|\.git.*|.*\.(tex|md|yml|yaml|json|log|bak|py))$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
RedirectMatch 404 /\.vscode
RedirectMatch 404 ^/src(/|$)
